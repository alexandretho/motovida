# Copie para .env e ajuste os valores antes de subir em produção
MYSQL_ROOT_PASSWORD=gere-uma-senha-forte-para-root
MYSQL_DATABASE=motovida
MYSQL_USER=motovida
MYSQL_PASSWORD=gere-uma-senha-forte-para-o-banco

# Chave usada para assinar a sessão (troque por um valor aleatório longo)
SECRET_KEY=gere-uma-chave-aleatoria-longa

# Em produção HTTPS atrás do NPM/Cloudflare, defina 1 para adicionar Secure ao cookie de sessão
SESSION_COOKIE_SECURE=0
# Política do cookie de sessão: lax (padrão), strict ou none. "none" exige SESSION_COOKIE_SECURE=1.
SESSION_COOKIE_SAME_SITE=lax
# Duração máxima do cookie de sessão, entre 900 e 86400 segundos
SESSION_COOKIE_MAX_AGE_SECONDS=28800
# Nome explícito do cookie de sessão para evitar colisão com outros apps no mesmo domínio
SESSION_COOKIE_NAME=motovida_session

# Usuário administrador criado automaticamente no primeiro boot
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=gere-uma-senha-forte-para-o-admin

# URL pública usada em sitemap.xml/robots.txt/templates (sem barra final)
SITE_URL=https://motovida.syntratech.com.br
# Hosts aceitos no header Host; SITE_URL, localhost e TestClient já são preservados
# ALLOWED_HOSTS=motovida.syntratech.com.br,www.motovida.syntratech.com.br
# No startup, o app registra alertas se segredos fracos/defaults, cookie inseguro em HTTPS
# ou ALLOWED_HOSTS=* forem detectados.

# ID do Google Analytics 4 injetado nos templates públicos
GA_MEASUREMENT_ID=G-VHCJDB0QNS

# Defina 1 somente atrás de Cloudflare/NPM (usa CF-Connecting-IP/X-Forwarded-For nos rate limits e logs HTTP)
# TRUST_PROXY_HEADERS=0
# Recomendado com NPM/Docker: confiar apenas no proxy em redes privadas/loopback.
# Use CIDRs explícitos ou presets (private, cloudflare) se o proxy estiver em uma rede conhecida; vazio mantém compatibilidade anterior.
# TRUSTED_PROXY_CIDRS=private

# Copie para .env e ajuste os valores antes de subir em produção
MYSQL_ROOT_PASSWORD=gere-uma-senha-forte-para-root
MYSQL_DATABASE=motovida
MYSQL_USER=motovida
MYSQL_PASSWORD=gere-uma-senha-forte-para-o-banco

# Chave usada para assinar a sessão (troque por um valor aleatório longo)
SECRET_KEY=dev-only-change-me

# Em produção HTTPS atrás do NPM/Cloudflare, defina 1 para adicionar Secure ao cookie de sessão
SESSION_COOKIE_SECURE=0

# Usuário administrador criado automaticamente no primeiro boot
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=dev-only-change-me

# Defina 1 somente atras de Cloudflare/NPM (usa CF-Connecting-IP nos rate limits e logs HTTP)
# TRUST_PROXY_HEADERS=0

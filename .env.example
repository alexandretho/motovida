# Copie para .env e ajuste os valores antes de subir em produção
MYSQL_ROOT_PASSWORD=gere-uma-senha-forte-para-root
MYSQL_DATABASE=motovida
MYSQL_USER=motovida
MYSQL_PASSWORD=gere-uma-senha-forte-para-o-banco

# Chave usada para assinar a sessão (troque por um valor aleatório longo)
SECRET_KEY=gere-uma-chave-aleatoria-longa

# Em produção HTTPS atrás do NPM/Cloudflare, defina 1 para adicionar Secure ao cookie de sessão
SESSION_COOKIE_SECURE=0

# Usuário administrador criado automaticamente no primeiro boot
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=gere-uma-senha-forte-para-o-admin

# URL pública usada em sitemap.xml/robots.txt/templates (sem barra final)
SITE_URL=https://motovida.syntratech.com.br

# ID do Google Analytics 4 injetado nos templates públicos
GA_MEASUREMENT_ID=G-VHCJDB0QNS

# Defina 1 somente atrás de Cloudflare/NPM (usa CF-Connecting-IP nos rate limits e logs HTTP)
# TRUST_PROXY_HEADERS=0
# Opcional: lista de IPs/CIDRs dos proxies confiáveis para aceitar os headers acima.
# Vazio mantém a compatibilidade atual quando TRUST_PROXY_HEADERS=1.
# TRUSTED_PROXY_CIDRS=

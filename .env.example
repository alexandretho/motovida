# Gere com `python3 scripts/init-env.py` para criar `.env` local com segredos aleatórios.
# Não reutilize nem publique o arquivo `.env`.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_GENERATED_SECRET
MYSQL_DATABASE=motovida
MYSQL_USER=motovida
MYSQL_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# Chave de sessão e senha inicial do administrador: o script gera valores aleatórios.
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# Acesso local sem HTTPS por padrão. Em produção com HTTPS, configure 1.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=28800
SESSION_COOKIE_NAME=motovida_session

# Exemplo neutro: substitua pelo domínio real antes da publicação.
SITE_URL=http://localhost:9205
# Opcional: hosts aceitos separados por vírgula. Vazio mantém SITE_URL + localhost.
ALLOWED_HOSTS=
# Opcional: Measurement ID próprio; vazio desativa analytics.
GA_MEASUREMENT_ID=

# Limite de corpo de formulários sensíveis (1 KiB a 1 MiB; padrão 64 KiB).
MAX_FORM_BODY_BYTES=65536

# Não confiar em headers de proxy por padrão. Para usar atrás de proxy confiável,
# habilite TRUST_PROXY_HEADERS=1 e configure TRUSTED_PROXY_CIDRS.
TRUST_PROXY_HEADERS=0
TRUSTED_PROXY_CIDRS=

# Dados fictícios (afiliado demo, cursos, parceiros e evento) ficam desativados.
SEED_SAMPLE_DATA=0

# Bind local seguro por padrão. Para acesso remoto, use proxy reverso/firewall.
APP_PORT=9205
APP_BIND_ADDRESS=127.0.0.1
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_BIND_ADDRESS=127.0.0.1
NPM_ADMIN_PORT=81
